{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client", "vite-plugin-pwa/react", "node"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],
  // the service worker has WebWorker globals instead of DOM; checked by tsconfig.sw.json
  "exclude": ["src/sw.ts"]
}
