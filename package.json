{
  "name": "anime-watcher",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "watch:add": "tsx src/cli/add.ts",
    "watch:list": "tsx src/cli/list.ts",
    "watch:remove": "tsx src/cli/remove.ts",
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "fast-xml-parser": "^5.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
